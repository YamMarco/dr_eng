# Supabase -> Project Settings -> Database -> Connection string.
# Copy to .env.local and fill in. On Vercel, set the same names under
# Project -> Settings -> Environment Variables.

# App runtime: Transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# drizzle-kit only (migrations/studio): Session pooler (port 5432) or direct URL.
# Optional - falls back to DATABASE_URL.
DATABASE_MIGRATE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# AI grading (server-side only, never VITE_). Models per role: src/lib/server/llmModels.ts.
# Vercel AI Gateway key (Vercel -> AI Gateway -> API Keys); Production only.
AI_GATEWAY_API_KEY="..."
# Gemini direct: the fallback, and enough on its own for local dev.
GEMINI_API_KEY="..."

# Accounts (Supabase Auth, email one-time code). Project Settings -> API Keys.
# Leave unset to run without accounts (the app stays open, as before auth).
# Public: ships in the web and mobile bundles.
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server only, never VITE_/PUBLIC_: used for account deletion.
SUPABASE_SECRET_KEY="sb_secret_..."
# Login CAPTCHA: Cloudflare Turnstile site key (public). Its secret goes in Supabase,
# Authentication -> Attack Protection -> CAPTCHA. Unset = no CAPTCHA.
VITE_TURNSTILE_SITE_KEY="0x4AAAA..."

# Daily practice reminder (Web Push). `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY="B..."
# Server only.
VAPID_PRIVATE_KEY="..."
# Vercel sends it to the reminder cron (long random string).
CRON_SECRET="..."

# Feedback reports (/api/feedback) are emailed through Resend (server only).
RESEND_API_KEY="re_..."
